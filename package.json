
{
  "name": "bharat-browser",
  "version": "1.1.0",
  "description": "Bharat Browser - A modern Indian desktop browser",
  "main": "main.js",
  "author": "Prithvi",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "in.bharat.browser",
    "productName": "Bharat Browser",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!assets/.gitkeep"
    ],
    "extraResources": [
      {
        "from": "assets/logo.png",
        "to": "assets/logo.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
